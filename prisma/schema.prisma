generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum UploadStatus {
  pending
  uploading
  processing
  completed
  failed
}

enum NotificationType {
  class_reminder
  schedule_update
  system
}

model User {
  id        String   @id @default(uuid())
  email         String   @unique
  name          String
  username      String   @unique
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  birthdate     DateTime? @map("birthdate")
  sex           String?   @map("sex")
  isAdmin       Boolean   @default(false) @map("is_admin")
  emailVerified Boolean  @default(false) @map("email_verified")
  failedAttempts Int      @default(0) @map("failed_attempts")
  lockedUntil   DateTime? @map("locked_until")
  avatarUrl String?  @map("avatar_url")
  city      String?
  school    String?
  course    String?
  year      Int?
  timezone  String   @default("Asia/Manila")
  theme     String   @default("system")
  notificationsEnabled Boolean @default(false) @map("notifications_enabled")
  locationEnabled Boolean @default(false) @map("location_enabled")
  requiresReauth Boolean @default(true) @map("requires_reauth")
  widgetToken String? @unique @map("widget_token")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  clientType String? @map("client_type")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  schedules     Schedule[]
  reminders     Reminder[]
  todos         Todo[]
  uploads       Upload[]
  notifications Notification[]
  feedbacks     Feedback[]
  pushSubscriptions PushSubscription[]
  fcmTokens        FCMToken[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  providerId String   @map("provider_id")
  accountId  String   @map("account_id")
  password   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier])
  @@map("verification")
}

model Schedule {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  semester     String?
  academicYear String?  @map("academic_year")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes Class[]
  uploads Upload[]

  @@index([userId])
  @@map("schedules")
}

model Class {
  id         String      @id @default(uuid())
  scheduleId String      @map("schedule_id")
  subject    String
  shortName  String?     @map("short_name")
  code       String?
  instructor String?
  room       String?
  section    String?
  block      String?
  notes      String?
  color      String      @default("#3b82f6")
  startTime  DateTime    @map("start_time")
  endTime    DateTime    @map("end_time")
  days       DayOfWeek[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  schedule  Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([scheduleId])
  @@map("classes")
}

model Reminder {
  id               String    @id @default(uuid())
  classId          String    @map("class_id")
  userId           String    @map("user_id")
  minutesBefore    Int       @default(15) @map("minutes_before")
  isActive         Boolean   @default(true) @map("is_active")
  lastSentAt       DateTime? @map("last_sent_at")
  lastStartSentAt  DateTime? @map("last_start_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([userId])
  @@map("reminders")
}

model Todo {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  text        String
  completed   Boolean   @default(false)
  priority    String    @default("medium")
  dueDate     String?   @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("todos")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String   @map("p256dh")
  auth      String
  timezone  String   @default("Asia/Manila")
  userAgent String?  @map("user_agent")
  device    String?  @map("device")
  platform  String?  @map("platform")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model FCMToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

model Upload {
    id           String       @id @default(uuid())
    userId       String       @map("user_id")
    scheduleId   String?      @map("schedule_id")
    fileUrl      String       @map("file_url")
    fileData     String?      @map("file_data")
    objectKey    String?      @map("object_key")
    fileName     String       @map("file_name")
    fileSize     Int          @map("file_size")
    mimeType     String       @map("mime_type")
  status       UploadStatus @default(pending)
  aiResult     Json?        @map("ai_result")
  errorMessage String?      @map("error_message")
  createdAt    DateTime     @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("uploads")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  body        String
  read        Boolean          @default(false)
  scheduledAt DateTime?        @map("scheduled_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum FeedbackType {
  bug
  feedback
  question
}

model Feedback {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  email     String?      @map("email")
  type      FeedbackType @default(feedback)
  subject   String?
  message   String
  page      String?      @map("page")
  status    String       @default("open") @map("status")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
}

// Persistent audit trail of user and admin activity. Written fire-and-forget
// from auditLog() so it never blocks the main flow. Kept even if the user is
// deleted (user_id is SET NULL, identity snapshot lives in email).
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?  @map("user_id")
  email     String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Persistent rate-limit counters shared across serverless instances.
// Each row tracks one fixed window (start of window, rounded down) for one
// key, so `count` is always reset when the window rolls over.
model RateLimitHit {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([key, windowStart])
  @@index([key])
  @@map("rate_limit_hits")
}

// Daily usage counters for the external-service caps that gate uploads and
// reminders (OpenRouter keys, Gemini, QStash, Backblaze B2). One row per
// service per calendar day. Powers the admin Limits dashboard so the
// "is the cap almost full?" question is always answerable.
model UsageCounter {
  id        String   @id @default(uuid())
  service   String
  date      String // "YYYY-MM-DD"
  count     Int      @default(0)
  bytes     BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at")

  @@unique([service, date])
  @@index([service])
  @@map("usage_counters")
}

// Latest provider-side rate-limit snapshot per service, captured from response
// headers (OpenRouter x-ratelimit-*). Authoritative for "how close is the cap"
// even when local request counters miss failed attempts.
model LimitSnapshot {
  service   String   @id
  remaining Int?
  limit     Int?
  resetAt   DateTime? @map("reset_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("limit_snapshots")
}
