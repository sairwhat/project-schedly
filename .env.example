# Copy this to .env.local and fill in real values
# WARNING: .env.local contains live secrets — keep it out of git, backups, and screenshots

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Okta: cron jobs hitting /api/cron/reminders (set if you enable Vercel Cron)
# CRON_SECRET=your-cron-secret

# Exact-time class reminders (Upstash QStash) — free tier:
# https://console.upstash.com/qstash  →  Copy "Token" and both "Signing Keys".
# If unset, exact-time delivery falls back to local service-worker alarms
# (works while the app is open) + the daily cron's heads-up push.
# QSTASH_TOKEN=qstash_xxx
# QSTASH_CURRENT_SIGNING_KEY=xxx
# QSTASH_NEXT_SIGNING_KEY=xxx

# Database
DATABASE_URL=postgresql://user:password@host:5432/db

# Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# AI Extraction (OpenRouter)
# Free API key: https://openrouter.ai/keys
# Optional backups OPENROUTER_API_KEY_2.._10 are tried in order on failure.
# Each free key carries its own ~50 requests/day cap, so multiple keys multiply
# the daily budget.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Set to "true" to disable OpenRouter until its next daily quota reset
# (re-enables automatically). Useful to rest the free quota and let Google
# AI Studio (Gemini) handle extraction instead.
# OPENROUTER_DISABLED=true

# AI Extraction (Google AI Studio / Gemini) — free tier ~1,500 requests/day.
# Key: https://aistudio.google.com/apikey
# Optional backups GEMINI_API_KEY_2.._10 are tried in order on failure.
# When OpenRouter is disabled, Gemini is used for every extraction.
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_API_KEY_2=your-second-key

# Optional: custom vision model. Default is the fastest free vision-capable
# model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free (~460ms latency).
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional: confidence threshold (0-1). Below this, the pipeline retries with a
# fallback vision model before accepting the result. Default: 0.9
# AI_CONFIDENCE_THRESHOLD=0.9

# Set to "false" to disable the Hy3 validation/reasoning fallback entirely.
# OPENROUTER_VALIDATION_ENABLED=false

# Result caching by perceptual image hash (skips AI for identical re-uploads).
# Set AI_CACHE_ENABLED=false to disable. Cache file path via AI_CACHE_FILE.
# AI_CACHE_ENABLED=true
# AI_CACHE_FILE=./cache/extraction-cache.json

# Structured pipeline logging. Set AI_STRUCTURED_LOGGING=false to silence,
# AI_LOG_LEVEL to debug|info|warn|error (default info).
# AI_STRUCTURED_LOGGING=true
# AI_LOG_LEVEL=info

# Email verification (Resend) — RESEND_FROM MUST be a verified domain in Resend
RESEND_API_KEY=re_your-key-here
RESEND_FROM=noreply@schedly.shop

# File storage (Backblaze B2) — S3-compatible, free tier, NO payment method
# required (bucket stays PRIVATE; images stream through
# /api/upload/{id}/file from B2, never from Neon). Also used for APK release
# files (releases/version.json + APKs) served via /api/version and
# /api/admin/apk-download. Setup: see BACKBLAZE-B2-SETUP.txt. Keys from
# Backblaze -> App Keys
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET=schedly-upload
# Optional override (defaults to s3.us-east-005.backblazeb2.com)
# B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase (client-side) — from your Firebase project console → Project settings → Web app
# NEXT_PUBLIC_FIREBASE_VAPID_KEY comes from Console → Cloud Messaging → Web push certificate
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-public-key-here

# Firebase admin (server-side) — from Console → Project settings → Service accounts → Generate key.
# Private key MUST be a single line with literal \n escape sequences (or base64).
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Bot protection (Cloudflare Turnstile)
# Get keys: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Security contact (for /.well-known/security.txt)
SECURITY_CONTACT=https://github.com/sairwhat/project-schedly/security/advisories/new

# Google Classroom integration (ADMIN-ONLY testing phase)
# Setup guide: see GOOGLE-CLASSROOM-SETUP.md
# Keep all of these server-side (never NEXT_PUBLIC_*):
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:3000/api/integrations/google-classroom/callback
# Feature flag: must be "true" for the integration to work at all.
# Access is still restricted to admins regardless of this flag.
GOOGLE_CLASSROOM_INTEGRATION_ENABLED=false
# Optional: dedicated key for encrypting OAuth tokens at rest (32+ bytes).
# Generate with: openssl rand -base64 32
# Falls back to BETTER_AUTH_SECRET when unset.
# GOOGLE_CLASSROOM_TOKEN_ENCRYPTION_KEY=

# Weather (OpenWeatherMap) — free tier: https://openweathermap.org/api
# OPTIONAL: when unset, the app falls back to Open-Meteo (keyless) automatically.
OPENWEATHER_API_KEY=your-key-here

# Facebook Graph API token for Area News (reads PUBLIC posts from PH news and
# government pages; real like/comment/share counts shown in the feed).
# Get one: developers.facebook.com → App → Tools → Graph API Explorer →
# pick your app → copy the User/App access token. No special permission needed
# for public page posts. When unset, Facebook posts are skipped automatically.
# FB_ACCESS_TOKEN=EAAG...long-lived-token...ZDZD
# Additional OpenRouter backup keys (tried in order when a key is rate-limited).
# Each key carries its own free ~50 req/day cap; the admin Limits dashboard
# aggregates ALL configured keys into one combined OpenRouter total.
# OPENROUTER_API_KEY_2=sk-or-v1-backup-key-here
# OPENROUTER_API_KEY_3=sk-or-v1-third-key-here
# OPENROUTER_API_KEY_4=sk-or-v1-fourth-key-here
# OPENROUTER_API_KEY_5=sk-or-v1-fifth-key-here
